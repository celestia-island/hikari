{
  "name": "@celestia-island/hikari",
  "version": "0.55.186",
  "private": false,
  "type": "module",
  "description": "Hikari Vue 3 component library — production-grade UI components based on shittim-chest design system",
  "license": "SySL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/celestia-island/hikari"
  },
  "homepage": "https://github.com/celestia-island/hikari",
  "keywords": [
    "vue3",
    "ui-components",
    "design-system",
    "hikari",
    "celestia-island"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./runtime": {
      "import": "./src/runtime/index.ts",
      "types": "./src/runtime/index.ts"
    },
    "./styles": {
      "import": "./src/styles/index.scss"
    },
    "./styles/*": "./src/styles/*",
    "./theme/*": "./src/theme/*",
    "./components/*": "./src/components/*",
    "./plugins": {
      "import": "./src/plugins/index.ts",
      "types": "./src/plugins/index.ts"
    }
  },
  "files": [
    "src/",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit",
    "build:docs": "vite build",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@types/three": "^*",
    "three": "^0.185",
    "vue": "^*"
  },
  "dependencies": {
    "@celestia-island/tairitsu-transport": "^0.2.0",
    "@xterm/addon-fit": "^0.*",
    "@xterm/addon-image": "^0.10.0-beta.301",
    "@xterm/xterm": "^6.1.0-beta.304",
    "dompurify": "^*",
    "echarts": "^*",
    "highlight.js": "^*",
    "lucide-vue-next": "^*",
    "marked": "^*"
  },
  "devDependencies": {
    "@types/node": "^*",
    "@types/three": "^*",
    "@vitejs/plugin-vue": "^*",
    "@vitejs/plugin-vue-jsx": "^*",
    "@vue/server-renderer": "^*",
    "happy-dom": "^*",
    "sass": "^*",
    "three": "^0.185",
    "typescript": "^*",
    "vite": "^*",
    "vitest": "^*",
    "vue-tsc": "^*"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ]
}
