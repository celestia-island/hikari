{
  "name": "@celestia-island/hikari",
  "version": "0.55.97",
  "private": false,
  "type": "module",
  "description": "Hikari Vue 3 component library — production-grade UI components based on shittim-chest design system",
  "license": "SySL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/celestia-island/hikari"
  },
  "homepage": "https://github.com/celestia-island/hikari",
  "keywords": [
    "vue3",
    "ui-components",
    "design-system",
    "hikari",
    "celestia-island"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./runtime": {
      "import": "./src/runtime/index.ts",
      "types": "./src/runtime/index.ts"
    },
    "./styles": {
      "import": "./src/styles/index.scss"
    },
    "./styles/*": "./src/styles/*",
    "./theme/*": "./src/theme/*",
    "./components/*": "./src/components/*",
    "./plugins": {
      "import": "./src/plugins/index.ts",
      "types": "./src/plugins/index.ts"
    }
  },
  "files": [
    "src/",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit",
    "build:docs": "vite build",
    "lint": "echo ok",
    "prepublishOnly": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "three": "^0.185.1",
    "vue": "^*"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^*",
    "echarts": "^*",
    "lucide-vue-next": "^*",
    "marked": "^*",
    "highlight.js": "^*"
  },
  "devDependencies": {
    "@types/three": "^*",
    "three": "^0.185.1",
    "@vitejs/plugin-vue": "^*",
    "@vitejs/plugin-vue-jsx": "^*",
    "@vue/server-renderer": "^*",
    "happy-dom": "^*",
    "sass": "^*",
    "typescript": "^*",
    "vite": "^*",
    "vue-tsc": "^*",
    "vitest": "^*",
    "@types/node": "^*"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ]
}
