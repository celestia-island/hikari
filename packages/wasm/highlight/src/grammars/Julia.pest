// Julia.pest — Julia syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "#" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "baremodule"    | "function"    | "continue"    | "finally"    | "export"    | "elseif"    | "module"    | "return"
    | "import"    | "global"    | "const"    | "using"    | "quote"    | "begin"    | "local"    | "ccall"
    | "false"    | "macro"    | "catch"    | "break"    | "where"    | "while"    | "else"    | "true"
    | "try"    | "for"    | "end"    | "let"    | "isa"    | "do"    | "in"    | "if"
    ) ~ !ident_char
}
builtin = @{ (
    "ProcessFailedException"    | "InvalidStateException"    | "ReadOnlyMemoryError"    | "TaskFailedException"    | "SubstitutionString"    | "StackOverflowError"    | "InterruptException"    | "AbstractIrrational"
    | "ExponentialBackOff"    | "CompositeException"    | "DimensionMismatch"    | "AbstractUnitRange"    | "UndefKeywordError"    | "SegmentationFault"    | "PermutedDimsArray"    | "CapturedException"
    | "MissingException"    | "AbstractVecOrMat"    | "OutOfMemoryError"    | "PartialQuickSort"    | "CartesianIndices"    | "UndefInitializer"    | "StringIndexError"    | "AbstractChannel"
    | "AbstractDisplay"    | "StridedVecOrMat"    | "AbstractMatrix"    | "AbstractVector"    | "LineNumberNode"    | "CartesianIndex"    | "IndexCartesian"    | "AssertionError"
    | "ErrorException"    | "AbstractString"    | "VersionNumber"    | "StridedVector"    | "UndefRefError"    | "ReentrantLock"    | "AbstractFloat"    | "LinearIndices"
    | "ArgumentError"    | "StridedMatrix"    | "OverflowError"    | "AbstractRange"    | "DenseVecOrMat"    | "AbstractArray"    | "UndefVarError"    | "AbstractChar"
    | "AbstractDict"    | "InexactError"    | "StridedArray"    | "RoundingMode"    | "OrdinalRange"    | "StepRangeLen"    | "DomainError"    | "IndexLinear"
    | "BoundsError"    | "DenseVector"    | "DivideError"    | "TextDisplay"    | "MethodError"    | "AbstractSet"    | "DenseMatrix"    | "SystemError"
    | "WeakKeyDict"    | "ComplexF16"    | "Irrational"    | "IndexStyle"    | "Cuintmax_t"    | "Cptrdiff_t"    | "RegexMatch"    | "DenseArray"
    | "NamedTuple"    | "ComplexF32"    | "ComplexF64"    | "Culonglong"    | "VecElement"    | "IOContext"    | "StepRange"    | "GlobalRef"
    | "Clonglong"    | "BitVector"    | "LoadError"    | "Condition"    | "SubString"    | "Cintmax_t"    | "Exception"    | "QuoteNode"
    | "InitError"    | "BitMatrix"    | "UnitRange"    | "TypeError"    | "BitArray"    | "KeyError"    | "IOStream"    | "Cwstring"
    | "EOFError"    | "LinRange"    | "Cwchar_t"    | "UnionAll"    | "SubArray"    | "Rational"    | "DataType"    | "BigFloat"
    | "VecOrMat"    | "IOBuffer"    | "Function"    | "Unsigned"    | "Cssize_t"    | "TypeVar"    | "Float64"    | "UInt128"
    | "Cstring"    | "WeakRef"    | "Nothing"    | "Complex"    | "Float32"    | "Cushort"    | "Cdouble"    | "Integer"
    | "Csize_t"    | "Float16"    | "Missing"    | "Channel"    | "Module"    | "Method"    | "UInt64"    | "NTuple"
    | "Symbol"    | "Cfloat"    | "Signed"    | "Cuchar"    | "Int128"    | "Cshort"    | "Vararg"    | "BitSet"
    | "UInt32"    | "Culong"    | "IdDict"    | "Vector"    | "Number"    | "UInt16"    | "Matrix"    | "BigInt"
    | "String"    | "Colon"    | "Array"    | "Regex"    | "Int64"    | "UInt8"    | "Int32"    | "Timer"
    | "Cchar"    | "RawFD"    | "Union"    | "Cvoid"    | "Int16"    | "Tuple"    | "Clong"    | "Cuint"
    | "HTML"    | "Cint"    | "Dims"    | "Char"    | "Text"    | "UInt"    | "Enum"    | "Bool"
    | "Real"    | "Expr"    | "Pair"    | "Some"    | "MIME"    | "Pipe"    | "Int8"    | "Dict"
    | "Task"    | "Type"    | "Any"    | "Val"    | "Set"    | "Ptr"    | "Cmd"    | "Ref"
    | "Int"    | "IO"
    ) ~ !ident_char
}
literal = @{ (
    "RoundNearestTiesAway"    | "RoundNearestTiesUp"    | "RoundFromZero"    | "InsertionSort"    | "PROGRAM_FILE"    | "RoundNearest"    | "RoundToZero"    | "ENDIAN_BOM"
    | "DEPOT_PATH"    | "RoundDown"    | "QuickSort"    | "MergeSort"    | "LOAD_PATH"    | "RoundUp"    | "devnull"    | "missing"
    | "nothing"    | "stderr"    | "C_NULL"    | "stdout"    | "Inf16"    | "stdin"    | "NaN16"    | "false"
    | "NaN32"    | "Inf64"    | "undef"    | "Inf32"    | "NaN64"    | "ARGS"    | "true"    | "Inf"
    | "NaN"    | "ENV"    | "im"    | "pi"    | "π"    | "ℯ"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
