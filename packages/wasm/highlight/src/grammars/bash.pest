// bash.pest — Bash syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "#" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "function"    | "select"    | "coproc"    | "until"    | "while"    | "elif"    | "then"    | "case"
    | "else"    | "done"    | "time"    | "esac"    | "for"    | "if"    | "do"    | "in"
    | "fi"
    ) ~ !ident_char
}
builtin = @{ (
    "comparguments"    | "compdescribe"    | "zregexparse"    | "unfunction"    | "compvalues"    | "compgroups"    | "zparseopts"    | "sha256sum"
    | "sha224sum"    | "sha384sum"    | "readarray"    | "functions"    | "sha512sum"    | "dircolors"    | "compfiles"    | "compquote"
    | "zcompile"    | "unexpand"    | "realpath"    | "readlink"    | "autoload"    | "comptags"    | "truncate"    | "compcall"
    | "printenv"    | "zmodload"    | "basename"    | "unsetopt"    | "readonly"    | "continue"    | "typeset"    | "pathchk"
    | "zformat"    | "bindkey"    | "timeout"    | "getopts"    | "unalias"    | "builtin"    | "unlimit"    | "history"
    | "emulate"    | "sha1sum"    | "mapfile"    | "suspend"    | "declare"    | "disable"    | "integer"    | "command"
    | "dirname"    | "comptry"    | "zsocket"    | "compctl"    | "logname"    | "whoami"    | "csplit"    | "runcon"
    | "rehash"    | "disown"    | "hostid"    | "base64"    | "mktemp"    | "ttyctl"    | "mkfifo"    | "ulimit"
    | "whence"    | "unhash"    | "noglob"    | "setcap"    | "unlink"    | "echoti"    | "caller"    | "md5sum"
    | "groups"    | "factor"    | "source"    | "echotc"    | "return"    | "expand"    | "base32"    | "logout"
    | "export"    | "chroot"    | "pushln"    | "enable"    | "printf"    | "numfmt"    | "uptime"    | "setopt"
    | "zstyle"    | "stdbuf"    | "getcap"    | "times"    | "touch"    | "alias"    | "vared"    | "tsort"
    | "getln"    | "umask"    | "local"    | "chcon"    | "clone"    | "sched"    | "uname"    | "users"
    | "cksum"    | "sleep"    | "shred"    | "chgrp"    | "paste"    | "b2sum"    | "chown"    | "split"
    | "nohup"    | "float"    | "shift"    | "print"    | "chmod"    | "mkdir"    | "break"    | "rmdir"
    | "unset"    | "shopt"    | "mknod"    | "nproc"    | "which"    | "pinky"    | "limit"    | "where"
    | "zprof"    | "pushd"    | "chdir"    | "stat"    | "wait"    | "nice"    | "zftp"    | "type"
    | "fold"    | "trap"    | "ztcp"    | "eval"    | "link"    | "jobs"    | "popd"    | "echo"
    | "sort"    | "zpty"    | "arch"    | "head"    | "vdir"    | "read"    | "uniq"    | "date"
    | "sync"    | "comm"    | "expr"    | "dirs"    | "test"    | "shuf"    | "exec"    | "help"
    | "join"    | "kill"    | "hash"    | "sudo"    | "tail"    | "exit"    | "stty"    | "bind"
    | "dir"    | "set"    | "bye"    | "log"    | "who"    | "seq"    | "zle"    | "ptx"
    | "cap"    | "cat"    | "let"    | "tee"    | "env"    | "fmt"    | "sum"    | "tty"
    | "pwd"    | "yes"    | "tac"    | "cut"    | "cp"    | "nl"    | "wc"    | "ls"
    | "rm"    | "fc"    | "dd"    | "df"    | "mv"    | "du"    | "ln"    | "fg"
    | "id"    | "cd"    | "tr"    | "pr"    | "od"    | "bg"
    ) ~ !ident_char
}
literal = @{ (
    "false"    | "true"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
