// crystal.pest — Crystal syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "#" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "instance_sizeof"    | "uninitialized"    | "__END_LINE__"    | "responds_to?"    | "annotation"    | "protected"    | "pointerof"    | "verbatim"
    | "abstract"    | "__LINE__"    | "__FILE__"    | "require"    | "include"    | "private"    | "__DIR__"    | "extend"
    | "struct"    | "module"    | "select"    | "return"    | "rescue"    | "unless"    | "sizeof"    | "ensure"
    | "typeof"    | "until"    | "class"    | "yield"    | "begin"    | "super"    | "union"    | "is_a?"
    | "macro"    | "elsif"    | "break"    | "alias"    | "while"    | "then"    | "nil?"    | "else"
    | "case"    | "next"    | "enum"    | "when"    | "with"    | "self"    | "type"    | "def"
    | "for"    | "asm"    | "as?"    | "end"    | "out"    | "fun"    | "lib"    | "do"
    | "if"    | "of"    | "as"
    ) ~ !ident_char
}
literal = @{ (
    "false"    | "true"    | "nil"
    ) ~ !ident_char
}

token = { comment | string | number | kw | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
