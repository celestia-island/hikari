// csharp.pest — C# syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "///" ~ (!"\n" ~ ANY)* | "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/"? }

kw = @{ (
    "descending"    | "stackalloc"    | "interface"    | "protected"    | "unmanaged"    | "ascending"    | "unchecked"    | "namespace"
    | "explicit"    | "volatile"    | "abstract"    | "implicit"    | "override"    | "internal"    | "operator"    | "readonly"
    | "required"    | "continue"    | "foreach"    | "orderby"    | "virtual"    | "private"    | "dynamic"    | "notnull"
    | "finally"    | "partial"    | "params"    | "remove"    | "sizeof"    | "unsafe"    | "global"    | "scoped"
    | "static"    | "sealed"    | "switch"    | "struct"    | "return"    | "select"    | "public"    | "record"
    | "typeof"    | "equals"    | "nameof"    | "extern"    | "alias"    | "throw"    | "while"    | "event"
    | "async"    | "const"    | "await"    | "fixed"    | "using"    | "break"    | "yield"    | "group"
    | "class"    | "where"    | "catch"    | "with"    | "from"    | "args"    | "void"    | "when"
    | "case"    | "else"    | "goto"    | "join"    | "this"    | "init"    | "base"    | "into"
    | "file"    | "lock"    | "not"    | "set"    | "and"    | "var"    | "ref"    | "new"
    | "for"    | "try"    | "let"    | "add"    | "get"    | "out"    | "on"    | "as"
    | "or"    | "in"    | "is"    | "by"    | "if"    | "do"
    ) ~ !ident_char
}
builtin = @{ (
    "delegate"    | "decimal"    | "dynamic"    | "ushort"    | "object"    | "string"    | "double"    | "float"
    | "nuint"    | "short"    | "ulong"    | "sbyte"    | "byte"    | "enum"    | "nint"    | "char"
    | "bool"    | "uint"    | "long"    | "int"
    ) ~ !ident_char
}
literal = @{ (
    "default"    | "false"    | "true"    | "null"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
