// css.pest — structural grammar for CSS/SCSS/LESS.
whitespace = @{ " " | "\t" }
newline = { "\r\n" | "\n" | "\r" }
comment = @{ "/*" ~ (!"*/" ~ ANY)* ~ "*/"? | "//" ~ (!"\n" ~ ANY)* }
string = @{ "\"" ~ (!"\"" ~ !"\n" ~ ANY)* ~ "\"" | "'" ~ (!"'" ~ !"\n" ~ ANY)* ~ "'" }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ("px" | "em" | "rem" | "%" | "vh" | "vw" | "s" | "ms")? }
kw = @{ ("important" | "media" | "import" | "from" | "to" | "and" | "not" | "only" | "var" | "calc" | "url" | "rgb" | "rgba" | "hsl" | "hsla") ~ !ident_char }
ident_char = _{ ASCII_ALPHANUMERIC | "-" | "_" }
identifier = @{ (ASCII_ALPHA | "-" | "_" | ".") ~ (ASCII_ALPHANUMERIC | "-" | "_")* }
operator = @{ "~" | ">" | "+" | "*" | "=" | "^=" | "$=" | "*=" | "|=" }
punctuation = @{ "{" | "}" | "(" | ")" | "[" | "]" | "," | ":" | ";" | "#" | "@" | "&" }
token = { comment | string | number | kw | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }
tokens = { token+ }
