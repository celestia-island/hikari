// erlang.pest — erlang syntax highlighting grammar.

// python.pest — Python syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "%" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "andalso"    | "receive"    | "orelse"    | "catch"    | "after"    | "maybe"    | "begin"    | "bnot"
    | "cond"    | "bxor"    | "case"    | "else"    | "when"    | "band"    | "let"    | "div"
    | "try"    | "not"    | "bsl"    | "fun"    | "and"    | "end"    | "bzr"    | "bor"
    | "rem"    | "xor"    | "if"    | "or"    | "of"
    ) ~ !ident_char
}

builtin = @{ (
    "string"    | "binary"    | "io_lib"    | "erlang"    | "lists"    | "timer"    | "code"    | "json"
    | "atom"    | "maps"    | "math"    | "ets"    | "io"    | "os"    | "re"
    ) ~ !ident_char
}

literal = @{ (
    "undefined"    | "error"    | "false"    | "true"    | "ok"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }

other = @{ ANY }

tokens = { token+ }
