// fsharp.pest — fsharp syntax highlighting grammar.


whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "//" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "namespace"    | "exception"    | "interface"    | "downcast"    | "override"    | "abstract"    | "internal"    | "function"
    | "delegate"    | "default"    | "mutable"    | "finally"    | "inherit"    | "private"    | "module"    | "return"
    | "extern"    | "downto"    | "inline"    | "struct"    | "member"    | "public"    | "global"    | "select"
    | "upcast"    | "assert"    | "static"    | "class"    | "begin"    | "while"    | "yield"    | "fixed"
    | "match"    | "open"    | "type"    | "elif"    | "void"    | "done"    | "lazy"    | "base"
    | "else"    | "then"    | "when"    | "with"    | "use"    | "let"    | "new"    | "try"
    | "not"    | "rec"    | "and"    | "fun"    | "end"    | "for"    | "val"    | "to"
    | "do"    | "as"    | "if"    | "or"    | "of"    | "in"
    ) ~ !ident_char
}

builtin = @{ (
    "invalidArg"    | "typedefof"    | "failwith"    | "infinity"    | "decimal"    | "sprintf"    | "printfn"    | "reraise"
    | "ignore"    | "string"    | "option"    | "sizeof"    | "result"    | "typeof"    | "float"    | "Error"
    | "raise"    | "async"    | "array"    | "enum"    | "char"    | "list"    | "uint"    | "None"
    | "Some"    | "bool"    | "dict"    | "byte"    | "unit"    | "seq"    | "fst"    | "exn"
    | "get"    | "int"    | "set"    | "obj"    | "snd"    | "nan"    | "ref"    | "Ok"
    ) ~ !ident_char
}

literal = @{ (
    "Error"    | "false"    | "Some"    | "true"    | "None"    | "null"    | "Ok"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }

other = @{ ANY }

tokens = { token+ }
