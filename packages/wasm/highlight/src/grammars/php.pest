// php.pest — php syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "#" ~ (!"\n" ~ ANY)* | "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/"? }

kw = @{ (
    "__COMPILER_HALT_OFFSET__"    | "__NAMESPACE__"    | "__FUNCTION__"    | "require_once"    | "include_once"    | "endforeach"    | "implements"    | "instanceof"
    | "__METHOD__"    | "enddeclare"    | "__CLASS__"    | "interface"    | "insteadof"    | "protected"    | "endswitch"    | "__TRAIT__"
    | "iterable"    | "abstract"    | "__FILE__"    | "callable"    | "endwhile"    | "__LINE__"    | "readonly"    | "continue"
    | "foreach"    | "extends"    | "private"    | "include"    | "boolean"    | "declare"    | "integer"    | "finally"
    | "require"    | "default"    | "__DIR__"    | "string"    | "global"    | "switch"    | "elseif"    | "return"
    | "object"    | "public"    | "double"    | "endfor"    | "binary"    | "throw"    | "while"    | "clone"
    | "never"    | "isset"    | "empty"    | "mixed"    | "array"    | "const"    | "float"    | "print"
    | "break"    | "unset"    | "final"    | "yield"    | "endif"    | "class"    | "catch"    | "trait"
    | "real"    | "from"    | "eval"    | "bool"    | "echo"    | "enum"    | "void"    | "list"
    | "case"    | "else"    | "goto"    | "exit"    | "use"    | "xor"    | "and"    | "var"
    | "int"    | "new"    | "die"    | "for"    | "try"    | "as"    | "or"    | "if"
    | "do"
    ) ~ !ident_char
}
builtin = @{ (
    "RecursiveCallbackFilterIterator"    | "RecursiveDirectoryIterator"    | "RecursiveIteratorIterator"    | "BadFunctionCallException"    | "InvalidArgumentException"    | "RecursiveCachingIterator"    | "UnexpectedValueException"    | "RecursiveFilterIterator"
    | "BadMethodCallException"    | "RecursiveArrayIterator"    | "__PHP_Incomplete_Class"    | "RecursiveRegexIterator"    | "CallbackFilterIterator"    | "RecursiveTreeIterator"    | "OutOfBoundsException"    | "DivisionByZeroError"
    | "SplDoublyLinkedList"    | "UnhandledMatchError"    | "OutOfRangeException"    | "ArgumentCountError"    | "FilesystemIterator"    | "UnderflowException"    | "DirectoryIterator"    | "IteratorAggregate"
    | "RecursiveIterator"    | "OverflowException"    | "SplTempFileObject"    | "MultipleIterator"    | "InfiniteIterator"    | "SplPriorityQueue"    | "SeekableIterator"    | "NoRewindIterator"
    | "RuntimeException"    | "IteratorIterator"    | "SplObjectStorage"    | "CachingIterator"    | "ArithmeticError"    | "php_user_filter"    | "DomainException"    | "LengthException"
    | "RangeException"    | "ErrorException"    | "LogicException"    | "FilterIterator"    | "AppendIterator"    | "AssertionError"    | "ParentIterator"    | "OuterIterator"
    | "SplFixedArray"    | "SplFileObject"    | "LimitIterator"    | "RegexIterator"    | "EmptyIterator"    | "ArrayIterator"    | "WeakReference"    | "GlobIterator"
    | "CompileError"    | "Serializable"    | "ArrayAccess"    | "SplFileInfo"    | "ArrayObject"    | "Traversable"    | "SplObserver"    | "SplMaxHeap"
    | "BackedEnum"    | "ParseError"    | "SplSubject"    | "Stringable"    | "SplMinHeap"    | "Throwable"    | "Countable"    | "Generator"
    | "TypeError"    | "Exception"    | "Directory"    | "Iterator"    | "stdClass"    | "SplStack"    | "UnitEnum"    | "SplQueue"
    | "SplHeap"    | "WeakMap"    | "Closure"    | "static"    | "parent"    | "Fiber"    | "self"
    ) ~ !ident_char
}
literal = @{ (
    "FALSE"    | "false"    | "null"    | "true"    | "NULL"    | "TRUE"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
