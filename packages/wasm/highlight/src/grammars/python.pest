// python.pest — Python syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "#" ~ (!"\n" ~ ANY)* | "#" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "continue"    | "finally"    | "return"    | "lambda"    | "import"    | "assert"    | "except"    | "global"
    | "class"    | "raise"    | "while"    | "break"    | "async"    | "await"    | "yield"    | "match"
    | "case"    | "with"    | "elif"    | "else"    | "from"    | "pass"    | "for"    | "not"
    | "try"    | "del"    | "def"    | "and"    | "is"    | "as"    | "or"    | "if"
    | "in"
    ) ~ !ident_char
}
builtin = @{ (
    "staticmethod"    | "classmethod"    | "issubclass"    | "memoryview"    | "isinstance"    | "breakpoint"    | "__import__"    | "enumerate"
    | "bytearray"    | "frozenset"    | "callable"    | "reversed"    | "property"    | "getattr"    | "compile"    | "setattr"
    | "hasattr"    | "delattr"    | "complex"    | "globals"    | "locals"    | "sorted"    | "filter"    | "object"
    | "divmod"    | "format"    | "float"    | "super"    | "bytes"    | "ascii"    | "print"    | "tuple"
    | "range"    | "input"    | "round"    | "slice"    | "hash"    | "repr"    | "type"    | "exec"
    | "eval"    | "vars"    | "help"    | "list"    | "iter"    | "open"    | "bool"    | "next"
    | "dict"    | "dir"    | "oct"    | "all"    | "set"    | "zip"    | "int"    | "hex"
    | "any"    | "max"    | "str"    | "ord"    | "bin"    | "chr"    | "len"    | "abs"
    | "min"    | "pow"    | "sum"    | "map"    | "id"
    ) ~ !ident_char
}
literal = @{ (
    "NotImplemented"    | "__debug__"    | "Ellipsis"    | "False"    | "None"    | "True"
    ) ~ !ident_char
}
type_kw = @{ (
    "Coroutine"    | "Optional"    | "Callable"    | "Sequence"    | "Literal"    | "Generic"    | "Tuple"    | "Union"
    | "List"    | "Dict"    | "Type"    | "Set"    | "Any"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | type_kw | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
