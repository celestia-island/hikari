// ruby.pest — Ruby syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "#" ~ (!"\n" ~ ANY)* | "#" ~ (!"\n" ~ ANY)* }

kw = @{ (
    "protected"    | "private"    | "include"    | "prepend"    | "require"    | "defined"    | "rescue"    | "extend"
    | "ensure"    | "return"    | "module"    | "public"    | "unless"    | "retry"    | "alias"    | "undef"
    | "throw"    | "until"    | "class"    | "elsif"    | "raise"    | "while"    | "break"    | "begin"
    | "BEGIN"    | "yield"    | "case"    | "then"    | "else"    | "when"    | "redo"    | "next"
    | "for"    | "not"    | "END"    | "end"    | "and"    | "or"    | "if"    | "do"
    | "in"
    ) ~ !ident_char
}
builtin = @{ (
    "private_constant"    | "module_function"    | "attr_accessor"    | "define_method"    | "attr_reader"    | "attr_writer"    | "lambda"    | "proc"
    ) ~ !ident_char
}
literal = @{ (
    "false"    | "true"    | "nil"
    ) ~ !ident_char
}

token = { comment | string | number | kw | builtin | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
