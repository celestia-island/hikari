// swift.pest — Swift syntax highlighting grammar.
// Auto-generated from highlight.js v11 by hljs_to_pest.py (one-time).
// Rule names use the standard token classification (engine.rs maps them).

whitespace = @{ (" " | "\t" | "\r")+ }
newline = { "\r\n" | "\n" | "\r" }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

string = @{ triple_dq | triple_sq | dq | sq }
triple_dq = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\""? }
triple_sq = @{ "'''" ~ (!"'''" ~ ANY)* ~ "'''"? }
dq = @{ "\"" ~ (!"\"" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "\""? }
sq = @{ "'" ~ (!"'" ~ !"\n" ~ ("\\" ~ ANY | ANY))* ~ "'"? }

number = @{ hex | bin | oct | float | int }
hex = @{ ("0x" | "0X") ~ ('0'..'9' | 'a'..'f' | 'A'..'F')+ }
bin = @{ ("0b" | "0B") ~ ('0'..'1')+ }
oct = @{ ("0o" | "0O") ~ ('0'..'7')+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
int = @{ ASCII_DIGIT+ }

identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

operator = @{ "===" | "!==" | "**" | "//" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "+=" | "-=" | "*=" | "/=" | "%=" | "->" | "=>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "=" | "!" | "&" | "|" | "^" | "~" | "?" | ":" }
punctuation = @{ "(" | ")" | "[" | "]" | "{" | "}" | "," | ";" | "." | "@" | "$" }

comment = @{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/"? }

kw = @{ (
    "#sourceLocation"    | "precedencegroup"    | "associatedtype"    | "#colorLiteral"    | "#imageLiteral"    | "#fileLiteral"    | "fallthrough"    | "fileprivate"
    | "nonisolated"    | "nonmutating"    | "convenience"    | "distributed"    | "#dsohandle"    | "extension"    | "borrowing"    | "subscript"
    | "#selector"    | "#filePath"    | "#function"    | "consuming"    | "typealias"    | "optional"    | "#keyPath"    | "rethrows"
    | "override"    | "mutating"    | "internal"    | "operator"    | "protocol"    | "#warning"    | "indirect"    | "isolated"
    | "required"    | "continue"    | "#column"    | "consume"    | "private"    | "dynamic"    | "#fileID"    | "unowned"
    | "postfix"    | "willSet"    | "package"    | "#elseif"    | "default"    | "deinit"    | "repeat"    | "import"
    | "didSet"    | "#endif"    | "prefix"    | "static"    | "switch"    | "struct"    | "throws"    | "return"
    | "public"    | "#error"    | "#else"    | "super"    | "actor"    | "throw"    | "while"    | "defer"
    | "macro"    | "infix"    | "async"    | "await"    | "#line"    | "inout"    | "#file"    | "break"
    | "final"    | "class"    | "where"    | "catch"    | "guard"    | "some"    | "open"    | "enum"
    | "copy"    | "lazy"    | "case"    | "each"    | "else"    | "weak"    | "func"    | "set"
    | "#if"    | "var"    | "for"    | "try"    | "let"    | "get"    | "any"    | "as"
    | "in"    | "is"    | "if"    | "do"
    ) ~ !ident_char
}
literal = @{ (
    "false"    | "true"    | "nil"
    ) ~ !ident_char
}

token = { comment | string | number | kw | literal | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }

tokens = { token+ }
