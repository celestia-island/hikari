// toml.pest — structural grammar for TOML.
whitespace = @{ " " | "\t" }
newline = { "\r\n" | "\n" | "\r" }
comment = @{ "#" ~ (!"\n" ~ ANY)* }
string = @{ "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\"" | "\"" ~ (!"\"" ~ !"\n" ~ ANY)* ~ "\"" | "'''" ~ (!"'''" ~ ANY)* ~ "'''" | "'" ~ (!"'" ~ !"\n" ~ ANY)* ~ "'" }
number = @{ ("+" | "-")? ~ (ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ | ASCII_DIGIT+) }
kw = @{ ("true" | "false" | "inf" | "nan") ~ !ident_char }
ident_char = _{ ASCII_ALPHANUMERIC | "_" | "-" }
identifier = @{ (ASCII_ALPHA | "_" | "-") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }
operator = @{ "=" }
punctuation = @{ "[" | "]" | "{" | "}" | "," | "." | ":" }
token = { comment | string | number | kw | identifier | operator | punctuation | whitespace | newline | other }
other = @{ ANY }
tokens = { token+ }
