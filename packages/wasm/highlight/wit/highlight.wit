package celestia:hikari-highlight@0.1.0;

// Contract version 0.1.0. Compatibility policy: additive changes bump the
// MINOR component (a new field, a new interface member, a new export); anything
// that removes or changes the meaning of an existing item bumps MAJOR. The
// version is part of the package id, so a consumer pins
// `celestia:hikari-highlight/<world>@<major>.<minor>` and a major bump is a new
// package rather than a silent break.

interface types {
    /// Highlight result: the HTML string (same format as
    /// highlight.js: `<span class="hljs-keyword">def</span>…`).
    record highlight-result {
        /// HTML string, or null when the language is not registered.
        html: option<string>,
    }
}

world highlight {
    use types.{highlight-result};
    /// Highlight `code` in `language`. Returns hljs-compatible HTML.
    export highlight: func(code: string, language: string) -> highlight-result;
    /// The list of languages this component supports.
    export languages: func() -> list<string>;
}
