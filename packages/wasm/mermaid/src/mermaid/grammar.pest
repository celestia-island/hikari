file = { SOI ~ diagram ~ EOI }

diagram = { kw ~ sp+ ~ direction ~ sp* ~ (nl | &EOI) ~ stmts }
kw = { "graph" | "flowchart" }
direction = { "TD" | "TB" | "BT" | "LR" | "RL" }

stmts = { (nl* ~ stmt)+ ~ nl* | nl* }
stmt = { sp* ~ stmt_inner ~ sp* }
stmt_inner = { subgraph | chain | nodedef | comment }

/* Subgraph (cluster) block: `subgraph <head>` ... `end`. The head is free
 * text — real mermaid accepts `subgraph Id["Title"]`, `subgraph ["Title"]`,
 * `subgraph Id`, `subgraph "Title"` and `subgraph Title`, and the family's
 * docs use the first two. Post-processing in graph_parser.rs splits an id
 * from a shape/title, which keeps this rule readable and PEG-friendly (a
 * multi-word bare title can never be an id, so it must not be guessed at
 * grammar level).
 *
 * A block with no `end` runs to EOF: the alternative is the keyword line
 * falling through to `nodedef` and painting the literal box this rule exists
 * to remove. Degrading to "one cluster that swallows the rest" keeps the
 * diagram readable on malformed input. */
subgraph = { subgraph_kw ~ sp+ ~ group_head ~ sp* ~ nl ~ stmts ~ (sp* ~ end_kw | &EOI) }
subgraph_kw = @{ "subgraph" ~ !(ASCII_ALPHANUMERIC | "_") }
end_kw = @{ "end" ~ !(ASCII_ALPHANUMERIC | "_") }
group_head = @{ (!nl ~ ANY)+ }

comment = { "%" ~ (!nl ~ ANY)* }

/* `end` closes a subgraph: a statement must never swallow it, or the block
 * would run to EOF (and a node named "end" would be painted, which is what
 * the docs site showed before clusters existed). */
chain = { !end_kw ~ refs ~ sp* ~ edge ~ sp* ~ refs ~ (sp* ~ edge ~ sp* ~ refs)* }
/* `A & B --> C & D` fans into the cross product of both sides, which is what
 * mermaid draws. */
refs = { nref ~ (sp* ~ "&" ~ sp* ~ nref)* }
nodedef = { !end_kw ~ nid ~ sp* ~ shape? }
nref = { nid ~ sp* ~ shape? }

nid = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

/* Node shapes, longest openers first: `(((` double-circle, `([` stadium,
 * `[[` subroutine, `[(` cylinder, `{{` hexagon, `[/` parallelogram,
 * `[\\` trapezoid, `>` asymmetric. The ORDER is the grammar: PEG tries
 * alternatives top-down, so a shorter opener placed earlier would swallow a
 * longer form's first characters and paint the rest as a label. */
shape = { dblcirc | stadium | subrt | cyl | hex | para | trap | asym | circ | rect | rnd | diam }
dblcirc = { "(((" ~ stxt ~ ")))" }
stadium = { "([" ~ stxt ~ "])" }
subrt = { "[[" ~ stxt ~ "]]" }
cyl = { "[(" ~ stxt ~ ")]" }
hex = { "{{" ~ stxt ~ "}}" }
para = { "[/" ~ ptxt ~ "/]" }
trap = { "[\\\\" ~ ptxt ~ "\\\\]" }
asym = { ">" ~ stxt ~ "]" }
circ = { "((" ~ stxt ~ "))" }
rect = { "[" ~ stxt ~ "]" }
rnd = { "(" ~ stxt ~ ")" }
diam = { "{" ~ stxt ~ "}" }
stxt = { (!("]" | ")" | "}" | nl | "|") ~ ANY)* }
/* Slash-delimited shapes (`[/text/]`, `[\\text\\]`) need a body that stops
 * before the closing delimiter pair, or `stxt` eats it. */
ptxt = { (!("/]" | "\\\\]") ~ ANY)* }

/* Links. Mermaid's link syntax is a family: `-->` arrow, `---`/`--` plain,
 * `-.->`/`-.-` dotted, `==>`/`===` thick, each optionally captioned — either
 * as `-->|caption|` or, for the plain forms, as `-- caption -->`. The
 * `--o` / `--x` / `<-->` heads change only the arrowHEAD (the renderer reads
 * them off the source); this rule classifies the LINE.
 *
 * Tried longest-first, and `arr_text`/`ln_text` come AFTER the plain forms so
 * `-->` is never read as `--` plus a caption. */
/* Head-adorned links and the bidirectional arrow.
 *
 * `A --o B` / `A --x B` put a circle or a cross at the TARGET end, and
 * `A <--> B` draws an arrow at BOTH ends. The head glyph is not a node: a
 * grammar that knows only the bare `--` reads the `o`/`x` as the target and
 * silently rewires the edge (`A --o B` became an edge to a node named "o"),
 * which is worse than a parse error because the diagram still renders — with
 * an invented box. They are classified as their line kind here. */
edge = { bi_arr | o_head | x_head | dotted_lbl | dotted | thick_lbl | thick | arr_lbl | arr_text | arr | ln_lbl | ln_text | ln }
bi_arr = { "<-->" ~ sp* ~ lbl? }
o_head = { "--o" ~ sp* ~ lbl? }
x_head = { "--x" ~ sp* ~ lbl? }
dotted_lbl = { "-.->" ~ sp* ~ lbl }
dotted = { "-.->" | "-.-" }
thick_lbl = { ("==>" | "===") ~ sp* ~ lbl }
thick = { "==>" | "===" }
arr_lbl = { "-->" ~ sp* ~ lbl }
arr = { "-->" }
ln_lbl = { "---" ~ sp* ~ lbl }
ln = { "---" | "--" ~ !">" ~ !"-" }
arr_text = { "--" ~ sp+ ~ ltxt_raw ~ sp* ~ "-->" }
ln_text = { "--" ~ sp+ ~ ltxt_raw ~ sp* ~ "---" }
lbl = { "|" ~ ltxt ~ "|" }
ltxt = { (!"|" ~ ANY)* }
/* The caption of a `-- text -->` link: everything up to the closing dashes. */
ltxt_raw = @{ (!("-->" | "---") ~ ANY)+ }

sp = _{ " " | "\t" }
nl = _{ "\r\n" | "\n" }
