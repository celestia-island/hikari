file = { SOI ~ diagram ~ EOI }

diagram = { kw ~ sp+ ~ direction ~ sp* ~ (nl | &EOI) ~ stmts }
kw = { "graph" | "flowchart" }
direction = { "TD" | "TB" | "BT" | "LR" | "RL" }

stmts = { (nl* ~ stmt)+ ~ nl* | nl* }
stmt = { sp* ~ stmt_inner ~ sp* }
stmt_inner = { subgraph | chain | nodedef | comment }

/* Subgraph (cluster) block: `subgraph <head>` ... `end`. The head is free
 * text — real mermaid accepts `subgraph Id["Title"]`, `subgraph ["Title"]`,
 * `subgraph Id`, `subgraph "Title"` and `subgraph Title`, and the family's
 * docs use the first two. Post-processing in graph_parser.rs splits an id
 * from a shape/title, which keeps this rule readable and PEG-friendly (a
 * multi-word bare title can never be an id, so it must not be guessed at
 * grammar level).
 *
 * A block with no `end` runs to EOF: the alternative is the keyword line
 * falling through to `nodedef` and painting the literal box this rule exists
 * to remove. Degrading to "one cluster that swallows the rest" keeps the
 * diagram readable on malformed input. */
subgraph = { subgraph_kw ~ sp+ ~ group_head ~ sp* ~ nl ~ stmts ~ (sp* ~ end_kw | &EOI) }
subgraph_kw = @{ "subgraph" ~ !(ASCII_ALPHANUMERIC | "_") }
end_kw = @{ "end" ~ !(ASCII_ALPHANUMERIC | "_") }
group_head = @{ (!nl ~ ANY)+ }

comment = { "%" ~ (!nl ~ ANY)* }

/* `end` closes a subgraph: a statement must never swallow it, or the block
 * would run to EOF (and a node named "end" would be painted, which is what
 * the docs site showed before clusters existed). */
chain = { !end_kw ~ nref ~ sp* ~ edge ~ sp* ~ nref ~ (sp* ~ edge ~ sp* ~ nref)* }
nodedef = { !end_kw ~ nid ~ sp* ~ shape? }
nref = { nid ~ sp* ~ shape? }

nid = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

shape = { circ | rect | rnd | diam }
circ = { "((" ~ stxt ~ "))" }
rect = { "[" ~ stxt ~ "]" }
rnd = { "(" ~ stxt ~ ")" }
diam = { "{" ~ stxt ~ "}" }
stxt = { (!("]" | ")" | "}" | nl) ~ ANY)* }

edge = { arr_lbl | arr | ln_lbl | ln }
arr_lbl = { "-->" ~ sp* ~ lbl }
arr = { "-->" }
ln_lbl = { "---" ~ sp* ~ lbl }
ln = { "---" }
lbl = { "|" ~ ltxt ~ "|" }
ltxt = { (!"|" ~ ANY)* }

sp = _{ " " | "\t" }
nl = _{ "\r\n" | "\n" }
