package celestia:hikari-mermaid@0.1.0;

// Contract version 0.1.0. Compatibility policy: additive changes bump the
// MINOR component (a new field, a new interface member, a new export); anything
// that removes or changes the meaning of an existing item bumps MAJOR. The
// version is part of the package id, so a consumer pins
// `celestia:hikari-mermaid/<world>@<major>.<minor>` and a major bump is a new
// package rather than a silent break.

interface types {
    /// The JSON-serialized mermaid AST (a MermaidDoc in the TS contract).
    record parse-result {
        /// JSON string of the parsed document, or null when the source
        /// is not a recognizable mermaid diagram.
        json: option<string>,
    }
}

world mermaid {
    use types.{parse-result};
    export parse: func(source: string) -> parse-result;
}
